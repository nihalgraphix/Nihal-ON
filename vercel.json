{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/contact",
      "destination": "/api/contact"
    },
    {
      "source": "/api/studio/data",
      "destination": "/api/studio/data"
    },
    {
      "source": "/api/studio/draft",
      "destination": "/api/studio/draft"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
